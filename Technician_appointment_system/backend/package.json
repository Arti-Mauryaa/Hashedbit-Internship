{
  "name": "tas-backend",
  "version": "1.0.0",
  "description": "Technician Appointment System - Backend API (Express + SQLite)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
